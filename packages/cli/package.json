{
  "name": "@sensos-ai/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "sensos": "./dist/sensos",
    "sensos-dev": "./src/cli/bootstrap.ts"
  },
  "scripts": {
    "build": "bun run scripts/build-sensos.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test --no-orphans --parallel tests/unit",
    "test:e2e": "bun run build && bun test --no-orphans tests/e2e",
    "test:stress": "bun run test --randomize --rerun-each=20",
    "test:coverage": "bun run test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:keyring": "bun run scripts/smoke-keyring.ts",
    "clean": "git clean -xdf node_modules dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@ai-sdk/gateway": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@inquirer/prompts": "^8.7.2",
    "@napi-rs/keyring": "2.1.0",
    "@sensos-ai/client": "workspace:*",
    "@sensos-ai/shared": "workspace:*",
    "ai": "catalog:",
    "drizzle-orm": "0.45.2",
    "nanoevents": "^10.0.0",
    "zod": "^4"
  }
}
