{
  "name": "@sensos-ai/client",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sensos-ai/sensos.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun --cwd ../.. bunup --filter client",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test --pass-with-no-tests",
    "prepublishOnly": "node -e \"if ((process.env.npm_config_registry || process.env.npm_package_publishConfig_registry || '').replace(/\\/$/, '') !== 'https://npm.pkg.github.com') throw new Error('Only GitHub Packages publication is allowed')\""
  },
  "dependencies": {
    "@durable-streams/client": "^0.2.7",
    "@sensos-ai/shared": "workspace:*",
    "ai": "catalog:",
    "rivetkit": "^2.3.12",
    "zod": "^4"
  }
}
