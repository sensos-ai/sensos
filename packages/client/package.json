{
  "name": "@sensos-ai/client",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun --cwd ../.. bunup --filter client",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test --pass-with-no-tests",
    "prepublishOnly": "node -e \"throw new Error('npm publication is disabled; use pkg.pr.new previews')\""
  },
  "dependencies": {
    "@durable-streams/client": "^0.2.7",
    "@sensos-ai/shared": "workspace:*",
    "ai": "catalog:",
    "rivetkit": "^2.3.12",
    "zod": "^4"
  }
}
