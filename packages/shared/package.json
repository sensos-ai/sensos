{
  "name": "@sensos-ai/shared",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sensos-ai/sensos.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./streams": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js"
    }
  },
  "scripts": {
    "build": "bun --cwd ../.. bunup --filter shared",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test --pass-with-no-tests",
    "prepublishOnly": "node -e \"if ((process.env.npm_config_registry || process.env.npm_package_publishConfig_registry || '').replace(/\\/$/, '') !== 'https://npm.pkg.github.com') throw new Error('Only GitHub Packages publication is allowed')\""
  },
  "dependencies": {
    "ai": "catalog:",
    "rivetkit": "^2.3.12",
    "zod": "^4"
  }
}
