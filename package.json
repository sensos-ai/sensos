{
  "name": "sensos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@ai-sdk/gateway": "^4.0.87",
    "@ai-sdk/openai": "^4.0.71",
    "@ai-sdk/provider": "^4.0.17",
    "@ai-sdk/provider-utils": "^5.0.45",
    "ai": "^7.0.107"
  },
  "scripts": {
    "build:packages": "bunup --filter shared,client",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "turbo run lint typecheck test build",
    "test:e2e:remote": "bun run scripts/test-remote-e2e.ts",
    "registry:validate": "bunx --bun shadcn@latest registry validate registry.json",
    "registry:validate:live": "bunx --bun shadcn@latest registry validate sensos-ai/sensos",
    "global:link": "bun run --cwd packages/cli build && bun link --cwd packages/cli",
    "global:unlink": "bun unlink --cwd packages/cli",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "ai": "catalog:",
    "bunup": "^0.16.32",
    "pkg-pr-new": "^0.0.88",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  }
}
